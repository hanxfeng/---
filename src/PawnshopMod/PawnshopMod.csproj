<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PawnshopMod</AssemblyName>
    <RootNamespace>PawnshopMod</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Keep in sync with <ModVersion> in manifest.xml -->
    <Version>0.2.6</Version>
    <!-- Where the game is. Override on the command line with: dotnet build -c Release -p:GameDir="D:\path\to\Probably Stolen" -->
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <ModInstallDir>$(GameDir)\Mods\$(AssemblyName)</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Files that ship with the mod besides the DLL: the manifest and the asset folders. -->
  <ItemGroup>
    <ModFile Include="manifest.xml;preview.png;Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
    <None Remove="Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
  </ItemGroup>

  <!-- After every build, install the mod into <game>\Mods\PawnshopMod\ so the game picks it up.
       Skip it with:  dotnet build -c Release -p:SkipInstall=true  (e.g. when the game folder is read-only). -->
  <Target Name="InstallMod" AfterTargets="Build" Condition="'$(SkipInstall)' != 'true'">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)" />
    <Copy SourceFiles="@(ModFile)" DestinationFiles="@(ModFile->'$(ModInstallDir)\%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('%(ModFile.FullPath)')" />
    <Message Importance="high" Text="Installed into $(ModInstallDir)" />
  </Target>

  <!-- 把最新的 dll / manifest / 本地化同步进创意工坊上传包（只有那个文件夹存在时才做）。
       这样 build.bat 之后直接跑 上传创意工坊\开始上传.bat 就是最新版本，不会忘同步。 -->
  <Target Name="SyncWorkshopUpload" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\上传创意工坊\PawnshopMod')">
    <PropertyGroup>
      <WorkshopDir>$(MSBuildProjectDirectory)\..\..\上传创意工坊\PawnshopMod</WorkshopDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(WorkshopDir)" />
    <Copy SourceFiles="manifest.xml" DestinationFolder="$(WorkshopDir)" />
    <Copy SourceFiles="Localization\zh.csv" DestinationFolder="$(WorkshopDir)\Localization" Condition="Exists('Localization\zh.csv')" />
    <Message Importance="high" Text="Workshop package synced: $(WorkshopDir)" />
  </Target>

</Project>
